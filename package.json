{
  "name": "kara",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Upload a song you own, get a KTV room. All processing happens in the browser.",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @kara/web run dev",
    "build": "pnpm -r run build",
    "lint": "eslint .",
    "typecheck": "tsc -p scripts/tsconfig.json --noEmit && pnpm -r run typecheck",
    "test": "vitest run",
    "check:attribution": "node scripts/check-attribution.mjs",
    "check:media": "node scripts/check-no-media.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run check:attribution && pnpm run check:media",
    "bench": "vitest run --config vitest.bench.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "playwright": "^1.64.1",
    "tesseract.js": "^7.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
